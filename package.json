{
  "name": "mrbarry.com",
  "type": "module",
  "version": "1.0.0",
  "description": "Personal and Professional portfolio",
  "dependencies": {
    "firebase": "^12.8.0",
    "firebase-tools": "^15.4.0",
    "hyperapp": "^2.0.22",
    "hyperapp-fx": "^2.0.0-beta.1",
    "pug": "^3.0.3",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "hyperapp-debug": "^1.0.0-beta.5"
  },
  "engines": {
    "node": ">= 24"
  },
  "scripts": {
    "start": "firebase serve",
    "deploy": "npm run build && firebase deploy",
    "build:pug": "node ./bin/html.js",
    "build:css": "tailwindcss -i ./src/assets/css/site.css -o ./public/assets/site.css",
    "build": "npm run build:pug && npm run build:css"
  },
